{
  "manifest_version": 3,
  "name": "BulkOperation",
  "version": "1.0.0",
  "description": "Select multiple rows in webpage grids and run supported row actions safely.",
  "action": {
    "default_title": "BulkOperation",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}